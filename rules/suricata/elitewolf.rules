# ELITEWOLF OT/ICS rules - Suricata 7 port (fork-maintained, not an NSA release)
#
# Ported from the upstream Snort 2 text files. SIDs follow fix/unique-sids
# (1000001-1000052, file order); rules that changed carry rev:2. Rules added from
# community pull requests use 1000101+. The upstream certificate rules came in
# threes (bare string, "commonName=...", "issuer_CN: ..."); the last two are
# log-formatter text that never appears on the wire. They are folded into one
# tls.cert_subject and one tls.cert_issuer rule per certificate, and SIDs
# 1000021 and 1000051 are retired. See rules/README.md for the SID map.
#
# These rules flag device presence and engineering activity. A hit is not
# necessarily malicious and needs follow-on analysis (see ELITEWOLF_SNORT_README.txt).

# ---------------------------------------------------------------------------
# Allen-Bradley / Rockwell Automation (web server diagnostic pages)
# Upstream matched these paths in traffic sourced from port 80, i.e. links in
# the device's HTML responses. Kept as response-body matches on any port.
# ---------------------------------------------------------------------------
alert http any any -> any any (msg:"ELITEWOLF Allen-Bradley/Rockwell Automation URL Path Activity-TCP REQUEST"; flow:established,to_client; file.data; content:"/rokform/advancedDiags?pageReq=tcp"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000001; rev:2; metadata:vendor Rockwell_Automation, protocol http, source ELITEWOLF;)
alert http any any -> any any (msg:"ELITEWOLF Allen-Bradley/Rockwell Automation URL Path Activity-SYSTEM DATA DETAIL"; flow:established,to_client; file.data; content:"/rokform/SysDataDetail?name="; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000002; rev:2; metadata:vendor Rockwell_Automation, protocol http, source ELITEWOLF;)
alert http any any -> any any (msg:"ELITEWOLF Allen-Bradley/Rockwell Automation URL Path Activity-UDP TABLE"; flow:established,to_client; file.data; content:"/rokform/advancedDiags?pageReq=udptable"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000003; rev:2; metadata:vendor Rockwell_Automation, protocol http, source ELITEWOLF;)
alert http any any -> any any (msg:"ELITEWOLF Allen-Bradley/Rockwell Automation URL Path Activity-TCP CONNECT"; flow:established,to_client; file.data; content:"rokform/advancedDiags?pageReq=tcpconn"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000004; rev:2; metadata:vendor Rockwell_Automation, protocol http, source ELITEWOLF;)
alert http any any -> any any (msg:"ELITEWOLF Allen-Bradley/Rockwell Automation URL Path Activity-IP ROUTE"; flow:established,to_client; file.data; content:"/rokform/advancedDiags?pageReq=iproute"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000005; rev:2; metadata:vendor Rockwell_Automation, protocol http, source ELITEWOLF;)
alert http any any -> any any (msg:"ELITEWOLF Allen-Bradley/Rockwell Automation URL Path Activity-GENERAL MEMORY"; flow:established,to_client; file.data; content:"/rokform/advancedDiags?pageReq=genmem"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000006; rev:2; metadata:vendor Rockwell_Automation, protocol http, source ELITEWOLF;)
alert http any any -> any any (msg:"ELITEWOLF Allen-Bradley/Rockwell Automation URL Path Activity-HEAP REQUEST"; flow:established,to_client; file.data; content:"/rokform/advancedDiags?pageReq=heap"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000007; rev:2; metadata:vendor Rockwell_Automation, protocol http, source ELITEWOLF;)
alert http any any -> any any (msg:"ELITEWOLF Allen-Bradley/Rockwell Automation URL Path Activity-ICMP REQUEST"; flow:established,to_client; file.data; content:"/rokform/advancedDiags?pageReq=icmp"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000008; rev:2; metadata:vendor Rockwell_Automation, protocol http, source ELITEWOLF;)
alert http any any -> any any (msg:"ELITEWOLF Allen-Bradley/Rockwell Automation URL Path Activity-ARP REQUEST"; flow:established,to_client; file.data; content:"/rokform/advancedDiags?pageReq=arp"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000009; rev:2; metadata:vendor Rockwell_Automation, protocol http, source ELITEWOLF;)
alert http any any -> any any (msg:"ELITEWOLF Allen-Bradley/Rockwell Automation URL Path Activity-UDP REQUEST"; flow:established,to_client; file.data; content:"/rokform/advancedDiags?pageReq=udp"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000010; rev:2; metadata:vendor Rockwell_Automation, protocol http, source ELITEWOLF;)
alert http any any -> any any (msg:"ELITEWOLF Allen-Bradley/Rockwell Automation URL Path Activity-IF REQUEST"; flow:established,to_client; file.data; content:"/rokform/advancedDiags?pageReq=if"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000011; rev:2; metadata:vendor Rockwell_Automation, protocol http, source ELITEWOLF;)
alert http any any -> any any (msg:"ELITEWOLF Allen-Bradley/Rockwell Automation URL Path Activity-IP REQUEST"; flow:established,to_client; file.data; content:"/rokform/advancedDiags?pageReq=ip"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000012; rev:2; metadata:vendor Rockwell_Automation, protocol http, source ELITEWOLF;)
alert http any any -> any any (msg:"ELITEWOLF Allen-Bradley/Rockwell Automation URL Path Activity-CSS Path"; flow:established,to_client; file.data; content:"/css/radevice.css"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000013; rev:2; metadata:vendor Rockwell_Automation, protocol http, source ELITEWOLF;)
alert http any any -> any any (msg:"ELITEWOLF Allen-Bradley/Rockwell Automation URL Path Activity-SYSTEM LIST DATA"; flow:established,to_client; file.data; content:"/rokform/SysListDetail?name="; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000014; rev:2; metadata:vendor Rockwell_Automation, protocol http, source ELITEWOLF;)

# ---------------------------------------------------------------------------
# Schweitzer Engineering Laboratories (SEL)
# Upstream ran the URL-path rules on port 443, where they cannot match unless
# the TLS session is decrypted. They now match HTTP on any port (plain HTTP
# management or decrypted HTTPS); over TLS the certificate rules apply.
# ---------------------------------------------------------------------------
alert http any any -> any any (msg:"ELITEWOLF SEL-3530-RTAC URL path activity - homepage"; flow:established,to_client; file.data; content:"/home.sel"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000015; rev:2; metadata:vendor SEL, product SEL-3530_RTAC, protocol http, source ELITEWOLF;)
alert http any any -> any any (msg:"ELITEWOLF SEL-3530-RTAC URL path activity - LoginError"; flow:established,to_client; content:"/errors/err401.sel?username="; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000016; rev:2; metadata:vendor SEL, product SEL-3530_RTAC, protocol http, source ELITEWOLF;)
alert http any any -> any any (msg:"ELITEWOLF SEL-3530-RTAC URL path activity - default.sel page"; flow:established,to_client; file.data; content:"/default.sel"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000017; rev:2; metadata:vendor SEL, product SEL-3530_RTAC, protocol http, source ELITEWOLF;)
alert ssh any 1024 -> any any (msg:"ELITEWOLF SEL-3530-RTAC Possible SSH Login Activity"; flow:established,to_client; ssh.software; content:"dropbear_2016.74"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000018; rev:2; metadata:vendor SEL, product SEL-3530_RTAC, protocol ssh, source ELITEWOLF;)
alert tcp any 5432 -> any any (msg:"ELITEWOLF SEL-3530-RTAC Possible AcSELerator Firmware Activity"; flow:established,to_client; content:"SEL-3530 RTAC"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000019; rev:2; metadata:vendor SEL, product SEL-3530_RTAC, protocol tcp, source ELITEWOLF;)

alert tls any any -> any any (msg:"ELITEWOLF_SEL-3620 X509 certificate activity - subject"; flow:established,to_client; tls.cert_subject; content:"http://www.sel-secure.com"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000020; rev:2; metadata:vendor SEL, product SEL-3620, protocol tls, source ELITEWOLF;)
alert tls any any -> any any (msg:"ELITEWOLF_SEL-3620 X509 certificate activity - issuer"; flow:established,to_client; tls.cert_issuer; content:"http://www.sel-secure.com"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000022; rev:2; metadata:vendor SEL, product SEL-3620, protocol tls, source ELITEWOLF;)

alert http any any -> any any (msg:"ELITEWOLF_SEL-2488 URL path activity"; flow:established,to_client; file.data; content:"/scripts/dScripts.sel"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000023; rev:2; metadata:vendor SEL, product SEL-2488, protocol http, source ELITEWOLF;)
alert http any any -> any any (msg:"ELITEWOLF_SEL-2488 URL path activity"; flow:established,to_client; file.data; content:"/css/sel.css?vid="; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000024; rev:2; metadata:vendor SEL, product SEL-2488, protocol http, source ELITEWOLF;)
alert tls any any -> any any (msg:"ELITEWOLF_SEL-2488 X509 certificate activity - subject"; flow:established,to_client; tls.cert_subject; content:"http://www.selinc.com/EthernetCommunications/"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000025; rev:2; metadata:vendor SEL, product SEL-2488, protocol tls, source ELITEWOLF;)
alert tls any any -> any any (msg:"ELITEWOLF_SEL-2488 X509 certificate activity - issuer"; flow:established,to_client; tls.cert_issuer; content:"http://www.selinc.com/EthernetCommunications/"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000026; rev:2; metadata:vendor SEL, product SEL-2488, protocol tls, source ELITEWOLF;)

alert tcp any 23 -> any any (msg:"ELITEWOLF SEL Telnet Activity"; flow:established,to_client; content:"SEL-"; pcre:"/SEL-[0-9]{3,4}/"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000027; rev:2; metadata:vendor SEL, protocol telnet, source ELITEWOLF;)
alert tcp any 23 -> any any (msg:"ELITEWOLF SEL Access Level 1 Change"; flow:established,to_client; content:"Level 1"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:protocol-command-decode; sid:1000028; rev:2; metadata:vendor SEL, protocol telnet, source ELITEWOLF;)
alert tcp any 23 -> any any (msg:"ELITEWOLF SEL Access Level 2 Change"; flow:established,to_client; content:"Level 2"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:protocol-command-decode; sid:1000029; rev:2; metadata:vendor SEL, protocol telnet, source ELITEWOLF;)
