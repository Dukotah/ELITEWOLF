alert tcp any any -> any 21 (msg:"ELITEWOLF SEL FTP Activity - Default Password"; flow:established,to_server; content:"PASS TAIL"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:default-login-attempt; sid:1000046; rev:2; metadata:vendor SEL, protocol ftp, source ELITEWOLF;)
