alert tcp any any -> any 21 (msg:"ELITEWOLF SEL FTP Activity - File Retrieval"; flow:established,to_server; content:"RETR SET_"; pcre:"/RETR SET_[0-9A-Z]{1,4}/"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:protocol-command-decode; sid:1000044; rev:2; metadata:vendor SEL, protocol ftp, source ELITEWOLF;)
