# ---------------------------------------------------------------------------
# Siemens
# ---------------------------------------------------------------------------
alert http any any -> any any (msg:"ELITEWOLF S7-1200 Possible Siemens Web Activity"; flow:established,to_client; file.data; content:"/CSS/S7Web.css"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000048; rev:2; metadata:vendor Siemens, product S7-1200, protocol http, source ELITEWOLF;)
alert http any any -> any any (msg:"ELITEWOLF S7-1200 Possible Siemens Web Activity"; flow:established,to_client; file.data; content:"/Images/CPU1200/"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000049; rev:2; metadata:vendor Siemens, product S7-1200, protocol http, source ELITEWOLF;)
alert tls any any -> any any (msg:"ELITEWOLF S7-1200 Possible Siemens X509 certificate activity - subject"; flow:established,to_client; tls.cert_subject; content:"S7-1200 Controller Family"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000050; rev:2; metadata:vendor Siemens, product S7-1200, protocol tls, source ELITEWOLF;)
alert tls any any -> any any (msg:"ELITEWOLF S7-1200 Possible Siemens X509 certificate activity - issuer"; flow:established,to_client; tls.cert_issuer; content:"S7-1200 Controller Family"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:misc-activity; sid:1000052; rev:2; metadata:vendor Siemens, product S7-1200, protocol tls, source ELITEWOLF;)

# Siemens LOGO! web login challenge brute force. From nsacyber/ELITEWOLF PR #7
# by Erwan Cordier (biero-el-corridor). The PR used "threshold:type limit",
# which caps alerts at 5 per 15 s instead of alerting once 5 are exceeded;
# detection_filter gives the intended "more than 5 in 15 s" behaviour.
alert http any any -> any any (msg:"ELITEWOLF SIEMENS LOGO! Attempted bruteforce on the web panel"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/AJAX"; startswith; http.request_body; content:"UAMCHAL:"; startswith; detection_filter:track by_src, count 5, seconds 15; reference:url,github.com/nsacyber/ELITEWOLF/pull/7; reference:url,github.com/jankeymeulen/siemens-logo-rest; classtype:attempted-user; sid:1000107; rev:1; metadata:vendor Siemens, product LOGO, protocol http, source ELITEWOLF_PR7;)

# ---------------------------------------------------------------------------
# Tridium Niagara (building automation). From nsacyber/ELITEWOLF PR #3 by
# Ken Buckler (kenbuckler). The PR's bare "Niagara" rule is dropped: it is a
# substring of the other three and matches any TLS payload containing the word.
# ---------------------------------------------------------------------------
alert tls any any -> any any (msg:"ELITEWOLF Niagara Possible NiagaraAX certificate activity - subject"; flow:established,to_client; tls.cert_subject; content:"NiagaraAX"; reference:url,github.com/nsacyber/ELITEWOLF/pull/3; classtype:misc-activity; sid:1000101; rev:1; metadata:vendor Tridium, product NiagaraAX, protocol tls, source ELITEWOLF_PR3;)
alert tls any any -> any any (msg:"ELITEWOLF Niagara Possible NiagaraAX certificate activity - issuer"; flow:established,to_client; tls.cert_issuer; content:"NiagaraAX"; reference:url,github.com/nsacyber/ELITEWOLF/pull/3; classtype:misc-activity; sid:1000102; rev:1; metadata:vendor Tridium, product NiagaraAX, protocol tls, source ELITEWOLF_PR3;)
alert tls any any -> any any (msg:"ELITEWOLF Niagara Possible Niagara4 certificate activity - subject"; flow:established,to_client; tls.cert_subject; content:"Niagara4"; reference:url,github.com/nsacyber/ELITEWOLF/pull/3; classtype:misc-activity; sid:1000103; rev:1; metadata:vendor Tridium, product Niagara4, protocol tls, source ELITEWOLF_PR3;)
alert tls any any -> any any (msg:"ELITEWOLF Niagara Possible Niagara4 certificate activity - issuer"; flow:established,to_client; tls.cert_issuer; content:"Niagara4"; reference:url,github.com/nsacyber/ELITEWOLF/pull/3; classtype:misc-activity; sid:1000104; rev:1; metadata:vendor Tridium, product Niagara4, protocol tls, source ELITEWOLF_PR3;)
alert tls any any -> any any (msg:"ELITEWOLF Niagara Possible NiagaraN4 certificate activity - subject"; flow:established,to_client; tls.cert_subject; content:"NiagaraN4"; reference:url,github.com/nsacyber/ELITEWOLF/pull/3; classtype:misc-activity; sid:1000105; rev:1; metadata:vendor Tridium, product NiagaraN4, protocol tls, source ELITEWOLF_PR3;)
alert tls any any -> any any (msg:"ELITEWOLF Niagara Possible NiagaraN4 certificate activity - issuer"; flow:established,to_client; tls.cert_issuer; content:"NiagaraN4"; reference:url,github.com/nsacyber/ELITEWOLF/pull/3; classtype:misc-activity; sid:1000106; rev:1; metadata:vendor Tridium, product NiagaraN4, protocol tls, source ELITEWOLF_PR3;)
