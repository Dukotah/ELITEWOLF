alert tcp any any -> any 21 (msg:"ELITEWOLF SEL FTP Activity - Access Change"; flow:established,to_server; content:"USER 2AC"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:default-login-attempt; sid:1000032; rev:2; metadata:vendor SEL, protocol ftp, source ELITEWOLF;)
alert tcp any any -> any 21 (msg:"ELITEWOLF SEL FTP Activity - Change working directory 2701"; flow:established,to_server; content:"CWD SEL-2701"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:protocol-command-decode; sid:1000033; rev:2; metadata:vendor SEL, product SEL-2701, protocol ftp, source ELITEWOLF;)
alert tcp any any -> any 21 (msg:"ELITEWOLF SEL FTP Activity - Change working directory 2701"; flow:established,to_server; content:"CWD /SEL-2701"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:protocol-command-decode; sid:1000034; rev:2; metadata:vendor SEL, product SEL-2701, protocol ftp, source ELITEWOLF;)
alert tcp any 21 -> any any (msg:"ELITEWOLF SEL FTP Activity - Current directory"; flow:established,to_client; content:"/SEL-2701"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:protocol-command-decode; sid:1000035; rev:2; metadata:vendor SEL, product SEL-2701, protocol ftp, source ELITEWOLF;)
alert tcp any any -> any 21 (msg:"ELITEWOLF SEL FTP Activity - RETR DNPMAP.TXT file"; flow:established,to_server; content:"RETR DNPMAP.TXT"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:protocol-command-decode; sid:1000036; rev:2; metadata:vendor SEL, protocol ftp, source ELITEWOLF;)
alert tcp any any -> any 21 (msg:"ELITEWOLF SEL FTP Activity - STOR SET_DNP1.TXT file"; flow:established,to_server; content:"STOR SET_DNP1.TXT"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:protocol-command-decode; sid:1000037; rev:2; metadata:vendor SEL, protocol ftp, source ELITEWOLF;)
alert tcp any any -> any 21 (msg:"ELITEWOLF SEL FTP Activity - potential file change"; flow:established,to_server; content:"STOR SET_"; pcre:"/STOR SET_[0-9A-Z]{1,4}\.TXT/"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:protocol-command-decode; sid:1000038; rev:2; metadata:vendor SEL, protocol ftp, source ELITEWOLF;)
alert tcp any any -> any 21 (msg:"ELITEWOLF SEL FTP Activity - Access Change ACC"; flow:established,to_server; content:"USER ACC"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:default-login-attempt; sid:1000039; rev:2; metadata:vendor SEL, protocol ftp, source ELITEWOLF;)
alert tcp any any -> any 21 (msg:"ELITEWOLF SEL FTP Activity - Password Login otter"; flow:established,to_server; content:"PASS otter"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:default-login-attempt; sid:1000040; rev:2; metadata:vendor SEL, protocol ftp, source ELITEWOLF;)
alert tcp any any -> any 21 (msg:"ELITEWOLF SEL FTP Activity - STOR DNPMAP.TXT file"; flow:established,to_server; content:"STOR DNPMAP.TXT"; reference:url,github.com/nsacyber/ELITEWOLF; classtype:protocol-command-decode; sid:1000041; rev:2; metadata:vendor SEL, protocol ftp, source ELITEWOLF;)
